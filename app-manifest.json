{
  "name": "adamsuk-factory",
  "description": "Applies the adamsuk/factory baseline (settings, ruleset, labels, files via PR) to repos tagged `factory`.",
  "url": "https://github.com/adamsuk/factory",
  "public": true,
  "hook_attributes": {
    "url": "https://github.com/adamsuk/factory",
    "active": false
  },
  "default_permissions": {
    "administration": "write",
    "contents": "write",
    "pull_requests": "write",
    "issues": "write",
    "workflows": "write",
    "metadata": "read"
  },
  "default_events": []
}
