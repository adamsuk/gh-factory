#!/usr/bin/env python3
"""gh CLI extension entrypoint: `gh factory ...`. Needs python3 (3.10+) and an authenticated gh."""

import os
import sys

if sys.version_info < (3, 10):
    sys.exit("gh factory needs Python 3.10 or newer")

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "src"))

from factory.cli import main  # noqa: E402

sys.exit(main())
